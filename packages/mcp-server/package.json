{
  "name": "@toolbridge/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "stdio": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/stdio.js",
    "http": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/http.js",
    "mcp:check": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/mcp-check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@toolbridge/agent-core": "workspace:*",
    "@toolbridge/spec-compiler": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
