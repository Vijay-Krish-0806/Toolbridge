{
  "name": "@toolbridge/agent-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/smoke.js",
    "tools:check": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/tools-check.js",
    "chat": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/chat.js",
    "failure-lab": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/failure-lab.js",
    "bench:context": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/bench-context.js",
    "knowledge:eval": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/knowledge-eval.js",
    "engines:compare": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/compare-engines.js",
    "openapi:check": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/openapi-check.js",
    "policy:check": "tsc -p tsconfig.build.json && node dist/scripts/policy-check.js"
  },
  "dependencies": {
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.5",
    "@toolbridge/policy": "workspace:*",
    "@toolbridge/retrieval": "workspace:*",
    "@toolbridge/shared": "workspace:*",
    "@toolbridge/spec-compiler": "workspace:*",
    "openai": "7.57.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
