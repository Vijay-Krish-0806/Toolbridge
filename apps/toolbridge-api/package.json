{
  "name": "@toolbridge/toolbridge-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "test:e2e": "tsc -p tsconfig.build.json && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-express": "12.5.0",
    "@toolbridge/agent-core": "workspace:*",
    "@toolbridge/checkpoint-mongo": "workspace:*",
    "@toolbridge/policy": "workspace:*",
    "@toolbridge/retrieval": "workspace:*",
    "@toolbridge/run-events": "workspace:*",
    "@toolbridge/spec-compiler": "workspace:*",
    "bullmq": "6.7.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "mongoose": "9.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
