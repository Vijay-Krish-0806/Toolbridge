{
  "name": "@toolbridge/host-store-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/seed/main.js",
    "db:hash": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/seed/hash.js",
    "start": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "check:access": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/check-access.js",
    "export:spec": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/export-spec.js",
    "test:e2e": "tsc -p tsconfig.build.json && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mongoose": "9.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
