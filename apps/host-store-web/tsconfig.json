{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js compiles the app itself (Turbopack); tsc only type-checks.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "scripts", "next.config.ts", ".next/types/**/*.ts"]
}
