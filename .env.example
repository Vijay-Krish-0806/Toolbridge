# Local development only. Copy to .env (never commit .env).
MONGO_ROOT_USERNAME=toolbridge
MONGO_ROOT_PASSWORD=change-me-local-only
MONGO_PORT=27017
REDIS_PORT=6379

# Host store API (apps/host-store-api). Use 127.0.0.1, not localhost: Docker publishes on IPv4 only,
# and localhost can resolve to IPv6 ::1 first.
MONGO_URI=mongodb://toolbridge:change-me-local-only@127.0.0.1:27017/?directConnection=true&authSource=admin
MONGO_DB=host_store
PORT=3000
# Signs access tokens. Use a long random value; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-replace-with-a-long-random-secret-0000
# Password for the seeded staff logins (owner@, support@, warehouse@store.example). Dev only.
SEED_STAFF_PASSWORD=change-me-local-only
# Freezes the API clock to the seed's reference date, so "delayed" and date filters match the data.
HOST_CLOCK_NOW=2026-11-01T00:00:00.000Z

# LLM (packages/agent-core). Local only: Ollama's OpenAI-compatible endpoint. Use 127.0.0.1, not localhost.
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Created from infra/ollama/qwen3.5-4b-16k.Modelfile (bakes in a 16K context window).
LLM_MODEL=toolbridge-qwen3.5-4b-16k
# Ollama ignores the key, but the OpenAI client requires a value.
LLM_API_KEY=ollama
# Must match the model's num_ctx. The OpenAI API cannot change it per request.
LLM_CONTEXT_LENGTH=16384
# Most tokens the model may write per call, reasoning included (a stream that never ends never times out).
LLM_MAX_OUTPUT_TOKENS=4096

# Host store API used by the hand-written tools (packages/agent-core). The account's role decides what the agent may do.
HOST_API_URL=http://127.0.0.1:3000
HOST_API_EMAIL=support@store.example
HOST_API_PASSWORD=change-me-local-only

# Optional hosted fallback (manual switch, see ADR 0012). Gemini's free tier is OpenAI-compatible, so the same
# adapter works: comment out the three LLM_ lines above and use these. Free tier: Google may use and human-review
# what you send, so use seeded demo data only. Limits seen 2026-11-18 for gemini-3.8-flash: 5 requests/min, 20/day.
# Multi-turn tool use does NOT work yet (Gemini needs a thought_signature echoed back; see ADR 0012).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=your-ai-studio-key
# LLM_CONTEXT_LENGTH=1048576

# ToolBridge platform API (Step 2.6, apps/toolbridge-api).
PLATFORM_PORT=4000
# development | test | production (the default when unset). Only development serves the dev login
# page at http://127.0.0.1:4000/dev/login (Step 4.4b). Never use development on a shared server.
PLATFORM_ENV=development
PLATFORM_MONGO_DB=toolbridge
# Creates tenants. At least 32 characters; the platform refuses this example value at startup.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_ADMIN_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
# Host names allowed to resolve to private addresses when fetching specs by URL. Platform-only;
# tenants can never set this. Leave empty unless you need to fetch from a local service.
PLATFORM_ALLOW_PRIVATE_HOSTS=
MAX_SPEC_BYTES=10485760
MAX_SPECS_PER_TENANT=20
SPEC_FETCH_TIMEOUT_MS=15000
# Envelope encryption master key (KEK): base64 of exactly 32 random bytes. The placeholder below is
# deliberately invalid, so the platform refuses to start until you generate a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_MASTER_KEY=generate-me
PLATFORM_MASTER_KEY_VERSION=v1
# Signs session tokens (Step 4.4b): base64 of exactly 32 random bytes, different from the master key.
# The placeholder is invalid on purpose. Generate one the same way as PLATFORM_MASTER_KEY.
PLATFORM_SESSION_KEY=generate-me
# During a rotation: the old key(s) as "v1=<base64>,v0=<base64>", until POST /admin/connections/rewrap.
PLATFORM_PREVIOUS_MASTER_KEYS=
# Run queue and workers (Step 4.4a, apps/toolbridge-worker). Redis port is REDIS_PORT above.
REDIS_HOST=127.0.0.1
RUN_QUEUE_PREFIX=toolbridge
# Longest one run leg may take before it is stopped and the run fails (ms). 600000 = 10 minutes.
RUN_LEG_TIMEOUT_MS=600000
WORKER_CONCURRENCY=2
# A dead worker's job is taken over after about this long (ms).
WORKER_LOCK_MS=30000
# Per-tenant limits (Step 4.5, token buckets in Redis): runs started per minute, tool calls per second.
RATE_RUNS_PER_MINUTE=30
RATE_TOOL_CALLS_PER_SECOND=10

# Embeddings for the tool index (Step 3.1, packages/retrieval). Ollama's native API root, not /v1.
# Pull the model first: ollama pull qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Must match the vector index. Changing it means dropping the tool_vectors_vector index and reindexing.
EMBEDDING_DIMENSIONS=1024
# Task instruction put in front of search queries only (Qwen3-Embedding format, Step 3.2).
# Changing it never re-embeds tools. Set it empty to send queries as they are.
EMBEDDING_QUERY_INSTRUCTION=Given a user request, retrieve the API tools that can fulfil it
