# Local development only. Copy to .env (never commit .env).
MONGO_ROOT_USERNAME=toolbridge
MONGO_ROOT_PASSWORD=change-me-local-only
MONGO_PORT=27017
REDIS_PORT=6379

# Host store API (apps/host-store-api). Use 127.0.0.1, not localhost: Docker publishes on IPv4 only,
# and localhost can resolve to IPv6 ::1 first.
MONGO_URI=mongodb://toolbridge:change-me-local-only@127.0.0.1:27017/?directConnection=true&authSource=admin
MONGO_DB=host_store
